# Required. SQLAlchemy async database URL.
# Docker Compose in this repo exposes PostgreSQL on localhost:5433.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5433/runner_db

# Required. Use a long random value in real local/prod env files.
SECRET_KEY=your-random-local-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Срок жизни основного access-токена (cookie). По умолчанию ~год;
# в проде стоит сократить (требует refresh-токенов на клиенте).
ACCESS_TOKEN_EXPIRE_DAYS=366

# CORS. По умолчанию "*". В проде укажите явные домены через запятую,
# например: ALLOWED_ORIGINS=https://app.moveup.ru,https://moveup.ru
ALLOWED_ORIGINS=*

# Required. MinIO/S3-compatible storage settings.
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=your-minio-user
MINIO_SECRET_KEY=your-minio-password
MINIO_BUCKET_NAME=photos
MINIO_POSTS_BUCKET_NAME=posts

# Required by settings, may be left empty if route-building features are disabled.
OPEN_ROUTE_API_KEY=

# Optional. Enables Firebase Cloud Messaging for chat push notifications.
# Keep the service account json outside git.
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FCM_ANDROID_CHANNEL_ID=moveup_messages

# Подтверждение email при регистрации. Если EMAIL_ENABLED=false или SMTP_HOST
# пуст — код подтверждения генерируется, но не отправляется (пишется в лог
# backend), чтобы фича работала в dev без почтового сервера. В проде задайте
# реальные SMTP-данные (например, Gmail/Mailgun/SendGrid SMTP).
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@moveup.app
SMTP_USE_TLS=true
